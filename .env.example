# OCR Document Extraction System - Environment Configuration
# Copy this file to .env and adjust values as needed

# Application Settings
APP_NAME="OCR Document Extraction"
APP_VERSION="0.1.0"
ENVIRONMENT="development"

# Storage Settings
STORAGE_TYPE="local"
STORAGE_PATH="./data/storage"
# STORAGE_BUCKET="my-documents-bucket"
# STORAGE_REGION="us-east-1"
STORAGE_ENCRYPTION_ENABLED="true"

# OCR Settings
OCR_PROVIDER="tesseract"
OCR_LANGUAGE="eng"
OCR_CONFIDENCE_THRESHOLD="0.7"
OCR_RATE_LIMIT="10"

# Search Settings
SEARCH_BACKEND="memory"
# SEARCH_HOST="localhost"
# SEARCH_PORT="9200"
SEARCH_INDEX_NAME="documents"

# Cache Settings
CACHE_ENABLED="true"
CACHE_TTL_SECONDS="3600"
CACHE_MAX_SIZE="1000"

# Security Settings
SECURITY_MALWARE_SCAN_ENABLED="true"
SECURITY_TLS_ENABLED="true"
SECURITY_ALLOWED_FILE_TYPES='["image/png", "image/jpeg", "image/jpg", "image/tiff", "application/pdf"]'

# Retry Settings
RETRY_MAX_ATTEMPTS="3"
RETRY_INITIAL_DELAY="1.0"
RETRY_MAX_DELAY="60.0"
RETRY_EXPONENTIAL_BASE="2.0"

# Logging Settings
LOG_LEVEL="INFO"
LOG_JSON="false"
